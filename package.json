{
  "name": "@natlibfi/melinda-record-import-controller",
  "description": "Controller microservice of Melinda record batch import system",
  "author": {
    "name": "The National Library of Finland"
  },
  "keywords": [],
  "homepage": "https://github.com/natlibfi/melinda-record-import-controller",
  "bugs": {
    "url": "https://github.com/natlibfi/melinda-record-import-controller/issues"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:natlibfi/melinda-record-import-controller.git"
  },
  "license": "MIT",
  "version": "1.0.6-alpha.2",
  "main": "src/index.js",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": "./dist/index.js",
  "scripts": {
    "prepare": "npm run build",
    "build": "esbuild \"src/**/*.js\" --sourcemap --platform=node --outdir=dist",
    "lint": "eslint ./src",
    "lint:dev": "eslint --fix ./src",
    "test:base": "node --test --test-force-exit --experimental-test-coverage --test-reporter=spec './src/*.test.js'",
    "test": "npm run lint && npm run test:base",
    "watch:test": "cross-env DEBUG=@natlibfi/* NODE_ENV=test node --watch --test --experimental-test-coverage --test-reporter=spec './src/*.test.js' './src/**/*.test.js'",
    "dev": "npm run watch:test",
    "dev:debug": "cross-env LOG_LEVEL=debug DEBUG=@natlibfi/* NODE_ENV=test npm run watch:test"
  },
  "dependencies": {
    "@natlibfi/melinda-backend-commons": "^3.0.0-alpha.6",
    "@natlibfi/melinda-record-import-commons": "^13.0.0-alpha.5",
    "amqplib": "^0.10.9",
    "moment": "^2.30.1",
    "mongodb": "^6.19.0"
  },
  "devDependencies": {
    "@natlibfi/fixugen": "^3.0.0-alpha.6",
    "@natlibfi/fixura": "^4.0.0-alpha.13",
    "@natlibfi/fixura-mongo": "^3.0.0-alpha.5",
    "@onify/fake-amqplib": "^3.2.0",
    "cross-env": "^10.0.0",
    "esbuild": "^0.25.9",
    "eslint": "^9.35.0"
  }
}
